# Backend base URL — when running locally with the vite proxy, leave empty.
# For production, set to your deployed backend URL: https://your-backend.onrender.com
VITE_API_BASE_URL=

# API key matching API_KEY in the backend .env.
#
# WARNING: every VITE_* value is inlined into the shipped JavaScript bundle by
# Vite and is therefore PUBLIC — readable by anyone who opens devtools. Treat
# this key as a rate-limiting handle, not a secret.
VITE_API_KEY=your-api-key-here

# There is deliberately NO VITE_ADMIN_KEY.
#
# The admin key must never reach the browser. Admin access works by POSTing the
# key once to /api/v1/admin/login, which returns an httpOnly session cookie that
# JavaScript cannot read. The operator types the key into the dashboard's login
# prompt; it is never baked into the build.
