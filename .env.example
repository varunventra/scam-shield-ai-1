# =============================================================================
# ScamShield AI — backend environment
# Every field read by app/core/config.py Settings is listed here.
# Copy to .env and fill in. .env is gitignored and must never be committed.
# =============================================================================

# --- API Configuration -------------------------------------------------------
# Shared key required on x-api-key for /conversation and /ai-scammer.
# Minimum 8 chars; generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEY=replace-me-with-a-generated-key
PORT=8000
HOST=0.0.0.0

# --- Admin authentication ----------------------------------------------------
# Required when DEBUG=false. Minimum 32 chars. This key is exchanged ONCE at
# POST /api/v1/admin/login for an httpOnly session cookie.
# NEVER expose this to a browser bundle or any VITE_* variable.
ADMIN_API_KEY=replace-me-with-a-32-char-minimum-key

# Evaluation mode: when true, read-only (GET) admin endpoints are served
# WITHOUT authentication so evaluators can open the dashboard with no key.
# Mutating admin endpoints still require ADMIN_API_KEY. Set back to false
# after the event — exports and PDFs contain scammer PII.
PUBLIC_DASHBOARD=false

# --- OpenAI (honeypot victim replies) ---------------------------------------
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.7
MAX_TOKENS=1000

# --- Featherless.ai (AI-scammer demo generator) -----------------------------
# Optional. Falls back to OpenAI when empty.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- MongoDB -----------------------------------------------------------------
# Required when DEBUG=false. Without it, sessions live in a process-local dict
# and are lost on every restart, and PDF storage is disabled entirely.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true

# --- CORS --------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API. Empty = same-origin
# only. "*" is stripped: wildcard plus credentials is rejected by browsers and
# would expose the admin surface.
ALLOWED_ORIGINS=http://localhost:5173

# --- Public base URL ---------------------------------------------------------
# Used ONLY to build PDF download links. Not used for CORS.
BASE_URL=

# --- Callback ----------------------------------------------------------------
# Optional webhook for final results. Empty = log-only mode.
CALLBACK_URL=

# --- Cost and abuse controls -------------------------------------------------
# Hard ceiling on LLM tokens per UTC day. Once hit, no further paid calls are
# made and the agent falls back to canned in-character replies.
DAILY_TOKEN_BUDGET=2000000
# Rejected with 422 above this many characters in a single message.
MAX_MESSAGE_CHARS=4000
# Rejected with 413 above this many bytes of request body.
MAX_REQUEST_BYTES=262144
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1

# --- Data retention ----------------------------------------------------------
# Days before a stored session (and its scammer PII) is deleted by a TTL index.
DATA_RETENTION_DAYS=180

# --- Application settings ----------------------------------------------------
DEBUG=False
LOG_LEVEL=INFO
MAX_CONVERSATION_TURNS=20
SESSION_TIMEOUT=3600

# --- Scam detection ----------------------------------------------------------
# Minimum confidence required to activate the honeypot agent (and therefore to
# spend money on an LLM call).
SCAM_CONFIDENCE_THRESHOLD=0.7

# --- Agent persona defaults --------------------------------------------------
AGENT_NAME=Rahul
AGENT_AGE=28
AGENT_OCCUPATION=Software Engineer
